    { "label": "IDE: backend tests", "type": "shell", "command": "cargo test --manifest-path src-tauri/Cargo.toml", "group": "test", "problemMatcher": "$rustc" },
    { "label": "ESP32 example: verify", "type": "shell", "command": "pio run -d examples/esp32-led -e esp32dev", "problemMatcher": "$gcc" },
    { "label": "ESP32 example: upload", "type": "shell", "command": "pio run -d examples/esp32-led -e esp32dev -t upload", "problemMatcher": "$gcc" }
  ]
}
